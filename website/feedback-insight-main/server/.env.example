# Salin ke .env lalu isi nilainya
PORT=3000

# Dari project Supabase / Lovable Cloud Anda
SUPABASE_URL=https://hnbbtonobnymlfjirgcj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Token bebas yang Anda buat sendiri. Wajib dikirim klien di header
